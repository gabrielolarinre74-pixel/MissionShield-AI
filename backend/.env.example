# MissionShield AI — Backend Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is gitignored.
# NASA_API_KEY defaults to DEMO_KEY for local development only.
# Use a personal NASA API key in production: https://api.nasa.gov/

# IBM watsonx.ai credentials (required)
WATSONX_APIKEY=
WATSONX_URL=
WATSONX_PROJECT_ID=
WATSONX_MODEL_ID=

# NASA DONKI API key (optional locally — DEMO_KEY has rate limits)
NASA_API_KEY=DEMO_KEY

# CORS — frontend origin allowed by the backend
FRONTEND_ORIGIN=http://localhost:3000

# Cache TTL in seconds (default: 300 = 5 minutes)
CACHE_TTL_SECONDS=300

# External API timeout in seconds (default: 10)
EXTERNAL_API_TIMEOUT_SECONDS=10
